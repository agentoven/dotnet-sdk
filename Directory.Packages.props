<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Hosting / DI -->
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />

    <!-- AI adapters -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.1" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.1" />
    <PackageVersion Include="OpenAI" Version="2.14.0" />
    <PackageVersion Include="Anthropic" Version="12.53.0" />
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.23.0" />
    <PackageVersion Include="Microsoft.SemanticKernel" Version="1.80.1" />
    <PackageVersion Include="Microsoft.SemanticKernel.Agents.Core" Version="1.80.1" />

    <!-- Tests -->
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.12" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="9.0.20" Condition="'$(TargetFramework)' == 'net9.0'" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="8.0.31" Condition="'$(TargetFramework)' == 'net8.0'" />
  </ItemGroup>
</Project>
